# Copy to .env.broker, OUTSIDE the document root, next to the broker directory.
# Real environment variables win over anything set here.

# Where this service answers, with no trailing path beyond the mount point.
# It builds the redirect URI registered with Google and Microsoft, so it must
# match what they have on file character for character.
BROKER_BASE_URL=https://api.example.com/oauth/v1/

# 32 random bytes, base64. Generate with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Changing it invalidates any handoff in flight, which is harmless.
BROKER_KEY=

DB_DSN=mysql:host=localhost;dbname=broker;charset=utf8mb4
DB_USER=
DB_PASS=

# From your Google Cloud project. Authorised redirect URI:
#   https://api.example.com/oauth/v1/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# From your Azure app registration. Redirect URI (type: Web):
#   https://api.example.com/oauth/v1/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Local development only. Allows a plain-HTTP site to be a return address.
# Leave empty in production: a handoff travelling over HTTP can be read, and
# it is worth real tokens for the few minutes it lives.
ALLOW_INSECURE_CALLBACKS=
